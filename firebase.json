{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "check-karo-app",
    "public": "hosting-site",
    "headers": [
      {
        "source": "/downloads/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"check-karo.apk\""
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ],
    "redirects": [
      {
        "regex": "^/(?P<rest>(?:[^d].*|d(?:[^o].*)?|do(?:[^w].*)?|dow(?:[^n].*)?|down(?:[^l].*)?|downl(?:[^o].*)?|downlo(?:[^a].*)?|downloa(?:[^d].*)?|download(?:[^s].*)?|downloads(?:[^/].*)?)?)$",
        "destination": "https://check-karo--ideathon-projects.us-central1.hosted.app/:rest",
        "type": 302
      }
    ]
  },
  "apphosting": {
    "backendId": "check-karo",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".git",
      ".firebase",
      "android",
      "ios",
      "resources",
      ".next",
      "cap-shell",
      "*.log",
      ".env.development.local"
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
