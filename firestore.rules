rules_version = '2';

// All reads and writes go through the Next.js server (firebase-admin), which
// bypasses these rules. Browsers and the mobile app never talk to Firestore
// directly, so direct client access is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
