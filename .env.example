# Copy to .env.local for local development.

# Claude API key (https://console.anthropic.com). Without it the app still works
# with saved schemes, but Verify, Assistant and AI discovery are disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Local Firestore emulator (npm run emulators). Remove these two lines and set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account key to use a real project.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=check-karo-demo
# Local only: stops firebase-admin probing the Google Cloud metadata server,
# which does not exist on a laptop. Never set this on App Hosting.
METADATA_SERVER_DETECTION=none

DISCOVERY_TTL_HOURS=72
