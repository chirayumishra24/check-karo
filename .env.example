# Copy to .env.development.local for local development (not loaded by production builds).

# Gemini API key from https://aistudio.google.com/apikey . Without it the app still
# works with saved schemes, but Verify, Assistant and AI discovery are disabled.
GEMINI_API_KEY=
# gemini-2.5-flash is only served to projects that used it before; if your key
# cannot use it, the app switches to GEMINI_FALLBACK_MODEL automatically.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Local Firestore emulator (npm run emulators). Remove these two lines and set
# GOOGLE_APPLICATION_CREDENTIALS to a service-account key to use a real project.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=check-karo-demo
# Local only: stops firebase-admin probing the Google Cloud metadata server,
# which does not exist on a laptop. Never set this on App Hosting.
METADATA_SERVER_DETECTION=none

DISCOVERY_TTL_HOURS=72

# Prefix for Firestore collection names, so Check Karo can share a Firebase
# project's database with other apps without collisions.
FIRESTORE_PREFIX=checkkaro_
